module Data.Monoid;

import Stdlib.Prelude open;

trait
type Monoid (A : Type) :=
  mk@{
    mempty : A;
    mappend : A -> A -> A;
  };

open Monoid;

foldMap {A : Type} {M : Type} {{Monoid M}} (f : A -> M) : List A -> M :=
  foldr (mappend << f) mempty;

mconcat {A : Type} {{Monoid A}} (xs : List A) : A := foldMap id xs;

instance
string : Monoid String := Monoid.mk "" (++str);
