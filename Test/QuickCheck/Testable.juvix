module Test.QuickCheck.Testable;

import Stdlib.Prelude open;
import Data.Random open;
import Test.QuickCheck.Arbitrary open;
import Test.QuickCheck.CoArbitrary open;
import Test.QuickCheck.Outcome open;
import Test.QuickCheck.Property open;
import Test.QuickCheck.Gen open;

--- A conversion from a Type A to a ;Property;
trait
type Testable (A : Type) :=
  mk@{
    toProp : A -> Property;
  };

forAll
  {A T : Type} {{Show A}} {{Arbitrary A}} {{Testable T}} : (A -> T) -> Property
  | prop :=
    Property.mk
      (Gen.mk
        \{rand :=
          let
            srand : Pair StdGen StdGen := stdSplit rand;
            rand1 : StdGen := fst srand;
            rand2 : StdGen := snd srand;
            arg : A := Gen.run Arbitrary.gen rand1;
            subProp : Property := Testable.toProp (prop arg);
            res : Outcome := runProp subProp rand2;
          in overFailure
            res
            \{f :=
              f@Failure{counterExamples := Show.show arg
                :: Failure.counterExamples f}}});

instance
testableProperty : Testable Property := Testable.mk id;

instance
testableOutcome : Testable Outcome :=
  Testable.mk \{r := Property.mk (Gen.mk (const r))};

instance
testableBool : Testable Bool :=
  let
    toOutcome : Bool -> Outcome
      | b := ite b success (failure (Failure.mk 0 nil));
  in Testable.mk \{b := Testable.toProp (toOutcome b)};

instance
testableFunction
  {A T} {{Show A}} {{Arbitrary A}} {{Testable T}} : Testable (A -> T) :=
  Testable.mk \{f := forAll f};

instance
showableFunction {A B : Type} : Show (A -> B) := Show.mk (const "function");
