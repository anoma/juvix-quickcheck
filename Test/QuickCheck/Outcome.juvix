module Test.QuickCheck.Outcome;

import Stdlib.Prelude open;
import Data.Monoid open;
import Data.String open;

type Failure :=
  mk@{
    seed : Nat;
    counterExamples : List String;
  };

type Outcome :=
  | success
  | failure Failure;

open Outcome public;

isSuccess : Outcome -> Bool
  | success := true
  | (failure _) := false;

showOutcome : Outcome -> String
  | success := "success"
  | (failure Failure.mk@{seed; counterExamples}) :=
    "failure "
      ++str "(seed : "
      ++str natToString seed
      ++str " , counterExamples: "
      ++str ("[" ++str intercalate ", " counterExamples ++str "]")
      ++str ")";

instance
showOutcomeI : Show Outcome := Show.mk showOutcome;

instance
monoidOutcome : Monoid Outcome :=
  Monoid.mk@{
    mempty := success;
    mappend :=
      \{
        | x@(failure _) _ := x
        | _ y := y
      };
  };

overFailure : Outcome -> (Failure -> Failure) -> Outcome
  | success _ := success
  | (failure x) f := failure (f x);

allSuccess : List Outcome -> Bool := isSuccess << foldMap id;
